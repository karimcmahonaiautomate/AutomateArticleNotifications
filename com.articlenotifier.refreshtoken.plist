<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.articlenotifier.refreshtoken</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <!-- REPLACE THE LINE BELOW: paste the absolute path this
             printed when you ran: pwd  (from inside the scripts folder) -->
        <string>/REPLACE/WITH/ABSOLUTE/PATH/TO/article-notifier/scripts/refresh_gmail_token.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>  <!-- 1 = Monday -->
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/article-notifier-refresh.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/article-notifier-refresh-error.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
